{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FinHub",
  "version": "0.3.0",
  "identifier": "app.finhub.terminal",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "node scripts/stage-python.mjs && pnpm dev",
    "beforeBuildCommand": "node scripts/stage-python.mjs && pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "FinHub",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 960,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8765 ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "dmg",
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "resources": {
      "pybundle/": "python/"
    },
    "externalBin": [
      "binaries/finhub-uv"
    ],
    "publisher": "FinHub",
    "shortDescription": "Open-source market research terminal",
    "copyright": "Copyright 2026 Adib Molla. Apache-2.0."
  }
}